# Entorno: dev | prod
APP_ENV=dev

# DSN de PostgreSQL (asyncpg). En docker compose el host es 'db'; fuera de docker, 'localhost'
DATABASE_URL=postgresql+asyncpg://pokegrading:pokegrading@localhost:5432/pokegrading_dev

# JWT
# En prod este secret viene de Azure Key Vault (clave kebab-case: pokegrading-jwt-secret)
JWT_SECRET_KEY=cambiame-en-prod-este-es-un-secret-de-desarrollo-muy-largo
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Logging
LOG_LEVEL=INFO

# Disclosure (CR-03, U9): se incrementa cuando cambia el texto legal del disclosure
DISCLOSURE_VERSION=v1.0

# Azure Blob Storage (Fase 1B)
# Pegar la connection string completa obtenida del Portal de Azure.
# Storage Account: stpokegradingdev (segun convencion del wiki DG §7.5)
# Ver docs/azure-setup.md para el paso a paso.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=stpokegradingdev;AccountKey=PEGAR_AQUI;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_CARTAS=cartas-referencia